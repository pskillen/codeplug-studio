# Copy to `.env.local` for local development (never commit real values).
VITE_GOOGLE_CLIENT_ID=
# Android OAuth client id for Capacitor APK builds (separate from web client)
VITE_GOOGLE_ANDROID_CLIENT_ID=
# Optional: pre-prod GA4 measurement ID for local analytics testing (G-XXXXXXXX)
VITE_GA_MEASUREMENT_ID=
# Optional: firmware release index (releases.json) for the flasher; default is pskillen/mm9pdy-firmware on GitHub
VITE_FIRMWARE_RELEASE_INDEX_URL=
# ngrok authtoken for "Run Dev Server" tunnel (https://dashboard.ngrok.com/get-started/authtoken)
NGROK_AUTHTOKEN=
